# Banjo — Supabase environment (local only, never commit this file)

# Copy these into your local .env file. .env is git-ignored.
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-side YouTube Data API v3 key; never prefix this with VITE_.
YOUTUBE_API_KEY=your_youtube_data_api_key_here
